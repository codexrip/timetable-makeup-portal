<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated != true)
                {
                    <RedirectToLogin />
                }
                else
                {
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-4 text-center">
                            <i class="bi bi-shield-lock text-danger fs-1 mb-2 d-block"></i>
                            <h1 class="h4 fw-bold text-danger mb-2">Access Denied</h1>
                            <p class="text-muted mb-3">
                                Your account does not have permission to access this page.
                            </p>
                            <a href="/" class="btn btn-primary btn-sm">Go to My Dashboard</a>
                        </div>
                    </div>
                }
            </NotAuthorized>
            <Authorizing>
                <div class="p-4 text-muted">Checking authorization...</div>
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(Layout.MainLayout)">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h4 text-danger mb-2">Page Not Found</h1>
                    <p class="text-muted mb-3">The requested page does not exist in this portal.</p>
                    <a href="/" class="btn btn-primary btn-sm">Back to Portal Home</a>
                </div>
            </div>
        </LayoutView>
    </NotFound>
</Router>
