@* Top navigation bar with university branding, sidebar toggle, and authenticated user dropdown *@

<header class="portal-topbar">
    <div class="topbar-left">
        <a href="/" class="d-flex align-items-center gap-2 text-decoration-none min-w-0">
            <img src="images/university-logo.png" alt="University Logo" class="topbar-logo" />
            <span class="topbar-title">Timetable &amp; Makeup Portal</span>
        </a>

        <button type="button"
                class="topbar-hamburger ms-2"
                @onclick="OnToggleSidebar"
                title="Toggle Sidebar"
                aria-label="Toggle Sidebar">
            <i class="bi bi-list"></i>
        </button>
    </div>

    <div class="topbar-right">
        <div class="dropdown">
            <button class="btn topbar-user-btn dropdown-toggle"
                    type="button"
                    id="userDropdownMenu"
                    data-bs-toggle="dropdown"
                    aria-expanded="false">
                <i class="bi bi-person-circle fs-5"></i>
                <span class="d-none d-sm-inline text-truncate" style="max-width: 220px;">
                    Welcome, @(string.IsNullOrWhiteSpace(UserName) ? "User" : UserName)
                </span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="userDropdownMenu">
                <li>
                    <h6 class="dropdown-header">
                        @UserName
                        @if (!string.IsNullOrWhiteSpace(UserRole))
                        {
                            <span class="badge bg-primary ms-1">@UserRole</span>
                        }
                    </h6>
                </li>
                <li>
                    <a class="dropdown-item" href="@(UserRole == "Teacher" ? "/teacher/dashboard" : "/coordinator/dashboard")">
                        <i class="bi bi-person-badge me-2 text-primary"></i>Profile
                    </a>
                </li>
                <li><hr class="dropdown-divider" /></li>
                <li>
                    <form action="/auth/logout" method="post" class="m-0">
                        <AntiforgeryToken />
                        <button type="submit" class="dropdown-item text-danger">
                            <i class="bi bi-box-arrow-right me-2"></i>Logout
                        </button>
                    </form>
                </li>
            </ul>
        </div>
    </div>
</header>

@code {
    [Parameter]
    public EventCallback OnToggleSidebar { get; set; }

    [Parameter]
    public string UserName { get; set; } = string.Empty;

    [Parameter]
    public string UserRole { get; set; } = string.Empty;
}
