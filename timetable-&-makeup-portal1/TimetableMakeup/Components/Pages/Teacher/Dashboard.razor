@page "/teacher/dashboard"
@attribute [Authorize(Roles = "Teacher")]
@inject CurrentUserService CurrentUser
@inject TimetableService TimetableService

<PageTitle>Teacher Dashboard</PageTitle>

<div class="portal-page-header">
    <div>
        <h1 class="portal-page-title">Teacher Dashboard</h1>
        <p class="text-muted small mb-0">Welcome back, @teacherName</p>
    </div>
    <a href="/teacher/makeup-requests" class="btn btn-primary btn-sm">
        <i class="bi bi-calendar-plus me-1"></i>Request Makeup Class
    </a>
</div>

@if (isLoading)
{
    <div class="d-flex align-items-center text-muted py-4">
        <span class="spinner-border spinner-border-sm text-primary me-2" role="status" aria-hidden="true"></span>
        <span>Loading dashboard...</span>
    </div>
}
else if (string.IsNullOrEmpty(teacherId))
{
    <div class="alert alert-warning">Your account is not linked to a teacher profile.</div>
}
else
{
    @if (stats.ReviewRequestedRequests > 0)
    {
        <div class="alert alert-info d-flex flex-wrap align-items-center justify-content-between gap-2 shadow-sm mb-4">
            <div class="small">
                <i class="bi bi-pencil-square me-2"></i>
                <strong>Action Needed:</strong> You have @stats.ReviewRequestedRequests makeup @(stats.ReviewRequestedRequests == 1 ? "request" : "requests") sent back for review.
            </div>
            <a href="/teacher/makeup-requests" class="btn btn-info btn-sm fw-semibold">
                Review &amp; Resubmit
            </a>
        </div>
    }

    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-3 mb-4">
        <div class="col">
            <StatCard Title="Assigned Courses"
                      Value="@stats.AssignedCourses.ToString()"
                      Icon="bi-book"
                      Color="primary" />
        </div>
        <div class="col">
            <StatCard Title="Assigned Sections"
                      Value="@stats.AssignedSections.ToString()"
                      Icon="bi-people"
                      Color="info" />
        </div>
        <div class="col">
            <StatCard Title="Today's Classes"
                      Value="@stats.TodaysClasses.ToString()"
                      Icon="bi-calendar-event"
                      Color="primary"
                      Subtitle="@DateTime.Today.DayOfWeek.ToString()" />
        </div>
        <div class="col">
            <StatCard Title="Pending Requests"
                      Value="@stats.PendingRequests.ToString()"
                      Icon="bi-hourglass-split"
                      Color="warning" />
        </div>
        <div class="col">
            <StatCard Title="Approved Requests"
                      Value="@stats.ApprovedRequests.ToString()"
                      Icon="bi-check-circle"
                      Color="success" />
        </div>
        <div class="col">
            <StatCard Title="Review Requested"
                      Value="@stats.ReviewRequestedRequests.ToString()"
                      Icon="bi-pencil-square"
                      Color="info"
                      Highlight="@(stats.ReviewRequestedRequests > 0)"
                      LinkHref="/teacher/makeup-requests"
                      LinkText="Open requests" />
        </div>
        <div class="col">
            <StatCard Title="Held Makeups"
                      Value="@stats.HeldRequests.ToString()"
                      Icon="bi-check2-all"
                      Color="primary" />
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <span class="fw-semibold">
                <i class="bi bi-calendar2-check me-2 text-primary"></i>My Upcoming Makeup Classes (Next 14 Days)
            </span>
            <a href="/teacher/makeup-requests" class="btn btn-outline-primary btn-sm">Manage Requests</a>
        </div>
        <div class="card-body p-0">
            @if (upcomingMakeups.Count == 0)
            {
                <div class="p-4 text-center text-muted small">
                    No makeup classes scheduled in the next 14 days.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Course</th>
                                <th>Section</th>
                                <th>Room</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in upcomingMakeups)
                            {
                                <tr>
                                    <td class="text-nowrap fw-semibold small">@m.Date.ToString("ddd, dd MMM yyyy")</td>
                                    <td class="text-nowrap small">@m.TimeRange</td>
                                    <td>
                                        <span class="badge bg-primary me-1">@m.CourseCode</span>
                                        @m.CourseTitle
                                    </td>
                                    <td>@m.SectionName</td>
                                    <td><i class="bi bi-geo-alt me-1 text-muted"></i>@m.RoomCode</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <span class="fw-semibold">
                <i class="bi bi-clock-history me-2 text-primary"></i>Today's Schedule (@DateTime.Today.DayOfWeek)
            </span>
            <a href="/teacher/my-timetable" class="btn btn-outline-primary btn-sm">Full Timetable</a>
        </div>
        <div class="card-body p-0">
            @if (todaysSchedule.Count == 0)
            {
                <div class="p-4 text-center text-muted small">
                    No classes scheduled for today.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Time</th>
                                <th>Course</th>
                                <th>Section</th>
                                <th>Room</th>
                                <th>Type</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in todaysSchedule)
                            {
                                <tr>
                                    <td class="text-nowrap fw-semibold small">@item.StartTime - @item.EndTime</td>
                                    <td>
                                        <span class="badge bg-primary me-1">@item.CourseCode</span>
                                        @item.CourseTitle
                                    </td>
                                    <td>@item.SectionName</td>
                                    <td><i class="bi bi-geo-alt me-1 text-muted"></i>@item.RoomCode</td>
                                    <td>
                                        @if (item.IsMakeup)
                                        {
                                            <span class="badge status-pending">Makeup</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border">Regular</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private string? teacherId;
    private string teacherName = string.Empty;
    private TeacherDashboardStats stats = new(0, 0, 0, 0, 0, 0, 0);
    private List<UpcomingMakeupView> upcomingMakeups = new();
    private List<TimetableSlotView> todaysSchedule = new();

    protected override async Task OnInitializedAsync()
    {
        var user = await CurrentUser.GetCurrentUserAsync();
        teacherId = user.TeacherId;
        teacherName = user.FullName;

        if (!string.IsNullOrEmpty(teacherId))
        {
            var today = DateTime.Today;
            stats = await TimetableService.GetTeacherDashboardStatsAsync(teacherId);
            upcomingMakeups = await TimetableService.GetTeacherUpcomingMakeupsAsync(teacherId, today, days: 14);
            var weekSlots = await TimetableService.GetTeacherTimetableAsync(teacherId, today);
            todaysSchedule = weekSlots
                .Where(s => s.DayOfWeek == today.DayOfWeek && (!s.IsMakeup || s.MakeupDate?.Date == today))
                .ToList();
        }

        isLoading = false;
    }
}
