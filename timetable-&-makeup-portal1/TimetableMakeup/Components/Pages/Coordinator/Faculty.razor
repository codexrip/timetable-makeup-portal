@page "/coordinator/faculty"
@attribute [Authorize(Roles = "Coordinator")]
@inject CurrentUserService CurrentUser
@inject TimetableService TimetableService

<PageTitle>Faculty</PageTitle>

<div class="portal-page-header">
    <h1 class="portal-page-title">Program Faculty</h1>
    <a href="/coordinator/teacher-timetables" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-person-workspace me-1"></i>View Teacher Timetables
    </a>
</div>

@if (isLoading)
{
    <div class="d-flex align-items-center text-muted py-4">
        <span class="spinner-border spinner-border-sm text-primary me-2" role="status" aria-hidden="true"></span>
        <span>Loading faculty members...</span>
    </div>
}
else if (faculty.Count == 0)
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center text-muted py-5">
            No faculty members found in your program.
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white fw-semibold">
            Teachers &amp; Assigned Courses (@faculty.Count)
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Code</th>
                            <th>Faculty Member</th>
                            <th>Designation</th>
                            <th>Specialization</th>
                            <th>Assigned Courses</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var member in faculty)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">@member.EmployeeCode</span></td>
                                <td>
                                    <div class="fw-semibold">@member.FullName</div>
                                    <div class="text-muted small">@member.Email</div>
                                </td>
                                <td>@member.Designation</td>
                                <td class="small text-muted">@member.Specialization</td>
                                <td>
                                    @if (member.Assignments.Count == 0)
                                    {
                                        <span class="text-muted small">No courses assigned</span>
                                    }
                                    else
                                    {
                                        <div class="d-flex flex-column gap-1">
                                            @foreach (var a in member.Assignments)
                                            {
                                                <div class="small">
                                                    <span class="badge bg-primary me-1">@a.CourseCode</span>
                                                    <span class="fw-semibold">@a.CourseTitle</span>
                                                    <span class="text-muted">(@a.SectionName)</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private List<FacultyMemberView> faculty = new();

    protected override async Task OnInitializedAsync()
    {
        var programId = await CurrentUser.GetProgramIdAsync();
        if (!string.IsNullOrEmpty(programId))
        {
            faculty = await TimetableService.GetProgramFacultyAsync(programId);
        }

        isLoading = false;
    }
}
