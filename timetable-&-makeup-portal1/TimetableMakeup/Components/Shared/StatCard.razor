@* Reusable dashboard KPI card *@

<div class="card shadow-sm h-100 @CardBorderClass">
    <div class="card-body d-flex align-items-center gap-3 p-3">
        <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0 @IconBgClass"
             style="width: 50px; height: 50px;">
            <i class="bi @Icon fs-4"></i>
        </div>
        <div class="min-w-0">
            <div class="text-muted small fw-semibold text-truncate">@Title</div>
            <div class="fs-3 fw-bold lh-sm text-dark">@Value</div>
            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <div class="text-muted" style="font-size: 0.78rem;">@Subtitle</div>
            }
            @if (!string.IsNullOrWhiteSpace(LinkHref) && !string.IsNullOrWhiteSpace(LinkText))
            {
                <a href="@LinkHref" class="small fw-semibold text-decoration-none d-inline-block mt-1">
                    @LinkText <i class="bi bi-arrow-right-short"></i>
                </a>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Value { get; set; } = "0";

    [Parameter]
    public string Icon { get; set; } = "bi-bar-chart";

    [Parameter]
    public string Color { get; set; } = "primary";

    [Parameter]
    public string? Subtitle { get; set; }

    [Parameter]
    public bool Highlight { get; set; }

    [Parameter]
    public string? LinkHref { get; set; }

    [Parameter]
    public string? LinkText { get; set; }

    private string CardBorderClass => Highlight
        ? Color switch
        {
            "danger" => "border border-2 border-danger bg-danger-subtle",
            "info" => "border border-2 border-info bg-info-subtle",
            "warning" => "border border-2 border-warning bg-warning-subtle",
            _ => "border border-2 border-primary"
        }
        : "border-0";

    private string IconBgClass => Color switch
    {
        "success" => "bg-success-subtle text-success",
        "warning" => "bg-warning-subtle text-warning-emphasis",
        "danger" => "bg-danger-subtle text-danger",
        "info" => "bg-info-subtle text-info-emphasis",
        _ => "bg-primary-subtle text-primary"
    };
}
