@* Reusable weekly timetable grid component with optional free vs occupied highlighting *@

@if (!HighlightFreeSlots && (Entries is null || Entries.Count == 0))
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-calendar-x fs-1 d-block mb-2"></i>
            @EmptyMessage
        </div>
    </div>
}
else
{
    @if (HighlightFreeSlots)
    {
        var totalPeriods = ActiveDays.Count * TimetableService.StandardSlots.Count;
        var occupiedPeriods = CountOccupiedPeriods();
        var freePeriods = totalPeriods - occupiedPeriods;

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
            <div class="d-flex align-items-center gap-3 small">
                <span class="d-inline-flex align-items-center gap-1">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">Occupied</span>
                    <span class="fw-semibold">@occupiedPeriods</span>
                </span>
                <span class="d-inline-flex align-items-center gap-1">
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Free</span>
                    <span class="fw-semibold">@freePeriods</span>
                </span>
                <span class="d-inline-flex align-items-center gap-1">
                    <span class="badge status-pending px-2 py-1">Makeup</span>
                </span>
            </div>
            <div class="text-muted small">
                Total weekly periods: @totalPeriods
            </div>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 135px;">Time Slot</th>
                            @foreach (var day in ActiveDays)
                            {
                                <th class="text-center">@day</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var slot in TimetableService.StandardSlots)
                        {
                            <tr>
                                <td class="bg-light fw-semibold small text-nowrap">
                                    <div>Slot @slot.SlotNumber</div>
                                    <div class="text-muted fw-normal">@slot.Label</div>
                                </td>
                                @foreach (var day in ActiveDays)
                                {
                                    var cellEntries = (Entries ?? Array.Empty<TimetableSlotView>())
                                        .Where(e => e.DayOfWeek == day && e.SlotNumber == slot.SlotNumber)
                                        .ToList();

                                    <td class="p-2" style="min-width: 170px; vertical-align: top;">
                                        @if (cellEntries.Count == 0)
                                        {
                                            if (HighlightFreeSlots)
                                            {
                                                <div class="rounded-2 border border-success-subtle bg-success-subtle text-success text-center small fw-semibold py-3">
                                                    <i class="bi bi-check-circle me-1"></i>Free
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="text-center text-muted small py-2">&mdash;</div>
                                            }
                                        }
                                        else
                                        {
                                            @foreach (var item in cellEntries)
                                            {
                                                var cardClass = item.IsMakeup
                                                    ? "border-warning bg-warning-subtle"
                                                    : HighlightFreeSlots
                                                        ? "border-primary-subtle bg-primary-subtle"
                                                        : "border-primary-subtle bg-light";

                                                <div class="p-2 rounded-2 border @cardClass mb-1">
                                                    <div class="d-flex justify-content-between align-items-center gap-1 mb-1">
                                                        <span class="badge bg-primary">@item.CourseCode</span>
                                                        @if (item.IsMakeup)
                                                        {
                                                            <span class="badge status-pending">
                                                                Makeup@(item.MakeupDate.HasValue ? $" · {item.MakeupDate.Value:dd MMM}" : "")
                                                            </span>
                                                        }
                                                    </div>
                                                    <div class="fw-semibold small text-dark lh-sm mb-1">@item.CourseTitle</div>
                                                    <div class="text-muted" style="font-size: 0.78rem;">
                                                        @if (ShowSection)
                                                        {
                                                            <div><i class="bi bi-people me-1"></i>@item.SectionName</div>
                                                        }
                                                        @if (ShowTeacher)
                                                        {
                                                            <div><i class="bi bi-person me-1"></i>@item.TeacherName</div>
                                                        }
                                                        <div><i class="bi bi-geo-alt me-1"></i>@item.RoomCode</div>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public IReadOnlyList<TimetableSlotView>? Entries { get; set; }

    [Parameter]
    public bool ShowTeacher { get; set; }

    [Parameter]
    public bool ShowSection { get; set; } = true;

    [Parameter]
    public bool HighlightFreeSlots { get; set; }

    [Parameter]
    public string EmptyMessage { get; set; } = "No classes scheduled in this timetable.";

    private IReadOnlyList<DayOfWeek> ActiveDays
    {
        get
        {
            var days = new List<DayOfWeek>
            {
                DayOfWeek.Monday,
                DayOfWeek.Tuesday,
                DayOfWeek.Wednesday,
                DayOfWeek.Thursday,
                DayOfWeek.Friday
            };

            if (Entries is not null && Entries.Any(e => e.DayOfWeek == DayOfWeek.Saturday))
            {
                days.Add(DayOfWeek.Saturday);
            }

            return days;
        }
    }

    private int CountOccupiedPeriods()
    {
        if (Entries is null || Entries.Count == 0)
        {
            return 0;
        }

        return Entries
            .Where(e => ActiveDays.Contains(e.DayOfWeek))
            .Select(e => (e.DayOfWeek, e.SlotNumber))
            .Distinct()
            .Count();
    }
}
